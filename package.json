{
  "name": "prismora",
  "private": true,
  "version": "0.1.0",
  "description": "Explore. Experiment. Understand. — A scientific simulation and experimentation platform.",
  "scripts": {
    "dev": "pnpm --filter @prismora/web dev",
    "build": "pnpm --filter @prismora/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @prismora/simulation-core test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3"
}
