{
  "name": "prismora",
  "private": true,
  "version": "0.1.0",
  "description": "Explore. Experiment. Understand. — Open-source scientific simulation and engineering virtual laboratory platform.",
  "license": "MIT",
  "author": "Amit Singh <https://github.com/iamamits>",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamamits/Prismora-Virtual-Lab.git"
  },
  "bugs": {
    "url": "https://github.com/iamamits/Prismora-Virtual-Lab/issues"
  },
  "homepage": "https://github.com/iamamits/Prismora-Virtual-Lab#readme",
  "keywords": [
    "virtual-lab",
    "scientific-simulation",
    "engineering",
    "physics-simulation",
    "ece",
    "risc-v",
    "automata-theory",
    "nextjs",
    "typescript",
    "education"
  ],
  "scripts": {
    "dev": "pnpm --filter @prismora/web dev",
    "build": "pnpm --filter @prismora/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @prismora/simulation-core test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3"
}
